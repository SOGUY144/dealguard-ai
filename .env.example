# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงเอง (ห้าม commit .env.local)

# Layer 1 / Layer 3 (GPT)
OPENAI_API_KEY=
# ชื่อโมเดลที่คีย์ของทีมใช้ได้ เช่นรุ่นที่รองรับ structured output
OPENAI_MODEL=
# โมเดลแปลงเสียงลูกค้าเป็นข้อความ (ภาษาไทย)
OPENAI_TRANSCRIBE_MODEL=

# เสียง AI ตอบลูกค้า (ElevenLabs) — ใช้เฉพาะเมื่อลูกค้ากดไมค์พูดมา
ELEVENLABS_API_KEY=
# voice id ของเสียง AI ผู้ชายจากคลังเสียง ElevenLabs (ไม่ใช่เสียงโคลนของคนจริง)
ELEVENLABS_VOICE_ID=
# โมเดลที่อ่านภาษาไทยได้ — เช็กด้วย npm run check-keys
ELEVENLABS_MODEL_ID=

# Supabase (ฐานข้อมูล + บัญชีผู้ใช้ + Realtime) — ดูใน Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role ข้าม RLS ได้ทั้งหมด: ใช้ฝั่ง server เท่านั้น ห้ามใส่ NEXT_PUBLIC_ นำหน้า
SUPABASE_SERVICE_ROLE_KEY=

# โดเมนของเว็บ ใช้ทำลิงก์ในอีเมล (ห้ามอ่านจาก header) — dev: http://localhost:3000 · Vercel: https://<โดเมนจริง>
SITE_URL=http://localhost:3000

# พร้อมเพย์ของร้าน (เบอร์มือถือ / เลขบัตร 13 หลัก) สำหรับ QR หน้าสรุปออเดอร์ — ไม่ใส่ = QR ตัวอย่างที่สแกนจ่ายจริงไม่ได้
# ใส่เฉพาะบัญชีของร้านเอง ห้ามใส่บัญชีคนอื่น
PROMPTPAY_ID=
